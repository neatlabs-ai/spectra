# ---------------------------------------------------------------------------
# Captured data and secrets
#
# SPECTRA writes to ~/.spectra by default, so nothing below normally lands in
# the repo. These patterns exist for the case where someone runs with
# SPECTRA_HOME=. or --db ./something, which is a reasonable thing to do while
# testing and a bad thing to commit: surface.db is a log of every wireless
# device your radios have heard, including your neighbours'.
# ---------------------------------------------------------------------------
.spectra/
*.db
*.db-journal
*.db-wal
*.db-shm
config.json
watchlist.json
oui.json

# exports
spectra_surface.csv
spectra_surface.json
*.pcap
*.pcapng

# API keys / env
.env
.env.*
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
